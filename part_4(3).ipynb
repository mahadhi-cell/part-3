      "source": [
        "import pandas as pd\n",
        "df = pd.read_csv(\"train.csv\")\n",
        "df[\"FamilySize\"] = df[\"SibSp\"] + df[\"Parch\"]\n",
        "result = df.groupby(\"FamilySize\")[\"Survived\"].mean()\n",
        "result = result.sort_values(ascending=False)\n",
        "print(result)"
